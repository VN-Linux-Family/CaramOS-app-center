#, python-format
msgid "Find more on %s"
msgstr "Tìm thêm trên %s"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:75
msgid "Pick the apps you need"
msgstr "Chọn những ứng dụng bạn cần"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:76
msgid ""
"CaramOS downloads and installs them in the background while you keep using "
"the computer. Add or remove apps later in the App Center."
msgstr ""
"CaramOS tải và cài ở chế độ nền, bạn vẫn dùng máy bình thường. Thêm hay gỡ "
"sau trong App Center."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:79
msgid ""
"You are trying CaramOS from the USB: apps installed now are lost when the "
"computer turns off. Install CaramOS to keep them."
msgstr ""
"Bạn đang dùng thử CaramOS từ USB: ứng dụng cài lúc này sẽ mất khi tắt máy. "
"Hãy cài CaramOS vào máy để giữ lại."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:103
msgid "Not now"
msgstr "Không cài lúc này"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:105
msgid "Pick one"
msgstr "Chọn một"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:105
msgid "Pick as many as you like"
msgstr "Chọn bao nhiêu cũng được"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:108
msgid "See more"
msgstr "Xem thêm"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:147
