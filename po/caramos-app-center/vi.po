#, python-format
msgid "Remove %s?"
msgstr "Gỡ %s?"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:198
msgid ""
"It is removed from this computer for every user. Your documents and other "
"files stay."
msgstr ""
"Ứng dụng bị gỡ khỏi máy, với mọi tài khoản. Tài liệu và các tệp khác của bạn "
"vẫn còn nguyên."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:200
msgid "Cancel"
msgstr "Hủy"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:236
#, python-format
msgid "%s was not installed"
msgstr "Chưa cài được %s"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:238
#, python-format
msgid "%d app was not installed"
msgid_plural "%d apps were not installed"
msgstr[0] "Chưa cài được %d ứng dụng"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:241
#, python-format
msgid "%d other app is installed."
msgid_plural "%d other apps are installed."
msgstr[0] "%d ứng dụng còn lại đã cài xong."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:243
msgid ""
"Try again now or later. If it still fails, press Ask for help to send VNLF "
"what the installer logged."
msgstr ""
"Thử lại ngay hoặc để sau. Nếu vẫn không được, bấm Nhờ giúp đỡ để gửi VNLF "
"nhật ký cài đặt."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:246
msgid ""
"Try again now or later. If it still fails, send the details below from "
"Feedback & Help."
msgstr ""
"Thử lại ngay hoặc để sau. Nếu vẫn không được, gửi phần Chi tiết bên dưới qua "
"Góp ý & hỗ trợ."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:253
#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:310
msgid "Ask for help"
msgstr "Nhờ giúp đỡ"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:257
#, python-format
msgid "Installed %d app"
msgid_plural "Installed %d apps"
msgstr[0] "Đã cài %d ứng dụng"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:258
msgid "You can find it in the Start menu."
msgid_plural "You can find them in the Start menu."
msgstr[0] "Ứng dụng mới đã có trong menu Start."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:260
msgid "Choose more apps"
msgstr "Chọn thêm ứng dụng"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:261
msgid "Close"
msgstr "Đóng"

