#: usr/lib/python3/dist-packages/caramos_app_center/ui/install.py:129
msgid "Not removed"
msgstr "Chưa gỡ"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/store.py:42
msgid "No suggested app matches your search."
msgstr "Không có ứng dụng gợi ý nào khớp với từ khoá."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/store.py:49
