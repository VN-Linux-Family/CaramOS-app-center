msgstr "Tìm thêm ứng dụng"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/store.py:132
#, python-format
msgid "Search “%s” on apps.vietnamlinuxfamily.net"
msgstr "Tìm “%s” trên apps.vietnamlinuxfamily.net"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/store.py:183
msgid "Install"
msgstr "Cài đặt"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/store.py:191
msgid "Strengths and weaknesses"
msgstr "Ưu và nhược điểm"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/store.py:194
msgid "Website"
msgstr "Trang chủ"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:77
msgid "Checking installed apps…"
msgstr "Đang kiểm tra ứng dụng đã cài…"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:112
msgid "No Internet connection"
msgstr "Chưa có kết nối Internet"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:113
msgid ""
"Connect to Wi-Fi or a network cable to download apps. CaramOS asks again at "
"the next login."
msgstr ""
"Kết nối Wi-Fi hoặc cắm dây mạng để tải ứng dụng. CaramOS sẽ hỏi lại ở lần "
"đăng nhập sau."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:116
msgid "Try again"
msgstr "Thử lại"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:120
#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:42
msgid "Later"
msgstr "Để sau"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:147
msgid "Authentication was cancelled. Nothing was changed."
msgstr "Bạn đã huỷ xác thực. Chưa có gì thay đổi."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:187
#, python-format
msgid "Remove %s?"
msgstr "Gỡ %s?"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:188
msgid ""
"It is removed from this computer for every user. Your documents and other "
"files stay."
msgstr ""
"Ứng dụng bị gỡ khỏi máy, với mọi tài khoản. Tài liệu và các tệp khác của bạn "
"vẫn còn nguyên."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:190
msgid "Cancel"
msgstr "Hủy"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:223
msgid "Some apps were not installed"
msgstr "Một số ứng dụng chưa cài được"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:224
#, python-format
msgid ""
"Not installed: %s. Check the connection and try again from the App Center."
msgstr "Chưa cài được: %s. Kiểm tra kết nối mạng rồi thử lại trong App Center."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:227
msgid "CaramOS is ready"
msgstr "CaramOS đã sẵn sàng"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:228
#, python-format
msgid "%d app was installed. You can find it in the menu."
msgid_plural "%d apps were installed. You can find them in the menu."
msgstr[0] "Đã cài %d ứng dụng. Bạn mở chúng từ menu."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:236
msgid "Choose more apps"
msgstr "Chọn thêm ứng dụng"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:239
msgid "Done"
msgstr "Đã xong"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:276
msgid "Open the App Center again any time"
msgstr "Bạn có thể mở lại App Center bất cứ lúc nào"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:277
msgid ""
"Double-click App Center on the Desktop, or look for “App Center” in the "
"Start menu."
msgstr ""
"Nhấp đúp biểu tượng App Center trên màn hình Desktop, hoặc tìm “App Center” "
"trong menu Start."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:279
msgid "Got it"
msgstr "Đã hiểu"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:296
#, python-format
msgid "%d app could not be installed."
msgid_plural "%d apps could not be installed."
msgstr[0] "%d ứng dụng chưa cài được."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:299
msgid "Your apps are installed and ready in the menu."
msgstr "Các ứng dụng đã cài xong, bạn mở chúng từ menu."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:309
#, python-format
msgid "%s is installed"
msgstr "Đã cài %s"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:309
#, python-format
msgid "%s was removed"
msgstr "Đã gỡ %s"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:310
#, python-format
msgid "Could not change %(app)s: %(error)s"
msgstr "Không thay đổi được %(app)s: %(error)s"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:310
msgid "unknown error"
msgstr "lỗi không rõ"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:39
msgid "Set up your apps"
msgstr "Chọn ứng dụng cho máy"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:43
msgid "Close now and ask again at the next login"
msgstr "Đóng lại, lần đăng nhập sau sẽ hỏi tiếp"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:86
msgid "Welcome to CaramOS"
msgstr "Chào mừng đến với CaramOS"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:87
msgid "Pick the apps you need. CaramOS downloads and installs them for you."
msgstr "Chọn những ứng dụng bạn cần, CaramOS sẽ tải và cài giúp bạn."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:90
msgid ""
"The recommended apps are already selected. Press Install at the bottom, or "
"change any choice below."
msgstr ""
"Các ứng dụng đề xuất đã được chọn sẵn. Bấm nút Cài ở dưới cùng, hoặc đổi lựa "
"chọn bên dưới."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:92
msgid ""
"Apps install in the background while you use the computer. Add more any time "
"from the App Center in the menu."
msgstr ""
"Ứng dụng cài chạy nền, bạn vẫn dùng máy bình thường. Muốn thêm lúc nào cũng "
"được, mở App Center trong menu."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:96
msgid ""
"You are trying CaramOS from the USB: apps installed now are lost when the "
"computer turns off. Install CaramOS to keep them."
msgstr ""
"Bạn đang dùng thử CaramOS từ USB: ứng dụng cài lúc này sẽ mất khi tắt máy. "
"Hãy cài CaramOS vào máy để giữ lại."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:119
msgid "Pick one"
msgstr "Chọn một"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:119
msgid "Pick any"
msgstr "Chọn tùy ý"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:151
msgid "Not now, I will choose later"
msgstr "Chưa cần, tôi sẽ chọn sau"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:163
msgid "Can't find the app you want?"
msgstr "Không có ứng dụng bạn mong muốn?"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:184
#, python-format
msgid "%d app"
msgid_plural "%d apps"
msgstr[0] "%d ứng dụng"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:185
#, python-format
msgid "About %s on disk"
msgstr "Khoảng %s dung lượng"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:186
#, python-format
msgid "Install %d app"
msgid_plural "Install %d apps"
msgstr[0] "Cài %d ứng dụng"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:188
msgid "No apps selected"
msgstr "Chưa chọn ứng dụng nào"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:189
msgid "Finish"
msgstr "Hoàn tất"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:191
#, python-format
msgid "includes %s of shared Flathub libraries, downloaded once"
msgstr "gồm %s thư viện Flathub dùng chung, chỉ tải một lần"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:194
msgid "You can keep using the computer while the apps install."
msgstr "Bạn vẫn dùng máy bình thường trong lúc cài."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:219
msgid "See more"
msgstr "Xem thêm"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:222
#, python-format
msgid "Open %s in the web browser"
msgstr "Mở %s trong trình duyệt"
