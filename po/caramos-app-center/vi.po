msgstr "Chưa cài được %(app)s: %(error)s"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:381
#, python-format
msgid "Could not remove %(app)s: %(error)s"
msgstr "Chưa gỡ được %(app)s: %(error)s"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:43
msgid "Choose apps for this computer"
msgstr "Chọn ứng dụng cho máy"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:47
msgid "Close now and ask again at the next login"
msgstr "Đóng lại, lần đăng nhập sau sẽ hỏi tiếp"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:57
