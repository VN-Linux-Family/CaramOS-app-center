msgid "Done"
msgstr "Xong"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/wizard.py:155
#, python-format
msgid "Includes %s shared by the apps from Flathub, downloaded once."
msgstr "Gồm %s dùng chung cho các ứng dụng từ Flathub, chỉ tải một lần."

#: usr/lib/python3/dist-packages/caramos_app_center/problem.py:94
#, python-format
msgid "%s did not finish installing, so every other install fails too."
msgstr "%s chưa cài xong, nên mọi lần cài khác đều lỗi."

#: usr/lib/python3/dist-packages/caramos_app_center/problem.py:96
msgid "Open Driver Check to replace the NVIDIA driver, then try again."
msgstr "Mở Kiểm tra driver để thay driver NVIDIA, rồi thử lại."

#: usr/lib/python3/dist-packages/caramos_app_center/problem.py:99
msgid ""
"Another program is installing software (the CaramOS installer or the Update "
"Manager). Wait until it is done, then try again."
msgstr ""
"Một chương trình khác đang cài phần mềm (trình cài đặt CaramOS hoặc Trình "
"quản lý cập nhật). Chờ nó xong rồi thử lại."
