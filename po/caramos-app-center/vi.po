msgstr "Không thành công: %s"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/install.py:117
msgid "Failed"
msgstr "Không thành công"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/install.py:128
