#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:119
msgid ""
"Connect to Wi-Fi or a network cable to download apps. CaramOS asks again at "
"the next login."
msgstr ""
"Kết nối Wi-Fi hoặc cắm dây mạng để tải ứng dụng. CaramOS sẽ hỏi lại ở lần "
"đăng nhập sau."

#: usr/lib/python3/dist-packages/caramos_app_center/ui/window.py:122
msgid "Connect to Wi-Fi or a network cable to download apps."
msgstr "Kết nối Wi-Fi hoặc cắm dây mạng để tải ứng dụng."

