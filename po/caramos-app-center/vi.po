#: usr/lib/python3/dist-packages/caramos_app_center/ui/store.py:65
#: usr/lib/python3/dist-packages/caramos_app_center/ui/store.py:128
msgid "All apps"
msgstr "Tất cả ứng dụng"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/store.py:81
msgid "Run the app picker again"
msgstr "Mở lại trình chọn ứng dụng"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/store.py:82
msgid "Menu"
msgstr "Menu"

