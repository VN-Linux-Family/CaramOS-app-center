msgstr "Đề xuất"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/common.py:91
msgid "Popular"
msgstr "Phổ biến"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/common.py:96
msgid "Flathub"
msgstr "Flathub"

#: usr/lib/python3/dist-packages/caramos_app_center/ui/common.py:98
